# Doctor's Email (Meeting Organizer / Admin)
DOCTOR_EMAIL=shivrajrbabar@gmail.com

# Base Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google Cloud OAuth 2.0 Credentials
# Get these from Google Cloud Console -> APIs & Services -> Credentials -> Create OAuth client ID
# Authorized redirect URI: http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Google OAuth Refresh Token (generated after one-time doctor authorization)
GOOGLE_REFRESH_TOKEN=
